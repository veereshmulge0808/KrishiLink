# ==============================================================================
# KrishiLink Environment Configuration Template
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=KrishiLink API
APP_VERSION=0.1.0
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-bytes-minimum
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL + PostGIS in production, SQLite fallback for local test runner)
# Production format: postgresql+psycopg://user:password@localhost:5432/krishilink
DATABASE_URL=postgresql+psycopg://krishi:link_secret@localhost:5432/krishilink
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
DB_ECHO=false

# Redis (Caching, WebSockets, Pub/Sub, Celery)
REDIS_URL=redis://localhost:6379/0

# Authentication & Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Telecom / OTP Configuration
# Set MOCK_OTP=true for local development and automated testing without real SMS
MOCK_OTP=true
MOCK_OTP_CODE=123456
OTP_EXPIRY_SECONDS=300

# Business Defaults
DEFAULT_FARMER_THRESHOLD_KG=20.0
LISTING_CUTOFF_HOUR_IST=18
ORDER_CUTOFF_HOUR_IST=20
WEIGHT_VARIANCE_TOLERANCE_PCT=2.0
ARRIVAL_GEOFENCE_METERS=150
